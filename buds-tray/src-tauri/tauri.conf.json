{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBuds",
  "version": "0.2.1",
  "identifier": "com.openbuds.tray",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenBuds",
        "width": 480,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Control your OnePlus Buds from the desktop",
    "longDescription": "Noise control and battery status for OnePlus Buds 4, without the phone app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
