<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for a bundled .app to use CoreBluetooth; without it macOS
	     terminates the app the first time it touches Bluetooth. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>OpenBuds uses Bluetooth to connect to your OnePlus Buds and control noise cancellation.</string>
</dict>
</plist>
